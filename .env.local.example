# ─────────── Backend API ───────────
# Base URL backend AFVS (NestJS). Dipakai lib API client di src/lib/api/.
NEXT_PUBLIC_AFVS_API_BASE=http://localhost:3001/api

# ─────────── Seed data demo (opsional) ───────────
# Auto-isi JADWAL FLIGHT DEMO saat pertama load / reset. DEFAULT OFF (produksi
# mulai kosong; jadwal diisi via sync FIDS atau manual). Set "true" HANYA untuk
# demo/latihan. Snapshot "default" yang disimpan operator (/flights → "Jadikan
# default") tetap dihormati apa pun nilai ini.
NEXT_PUBLIC_SEED_DEMO_FLIGHTS=false

# ─────────── Observability (opsional) ───────────
# DSN project Sentry (platform Next.js). Kosongkan → Sentry nonaktif (no-op).
NEXT_PUBLIC_SENTRY_DSN=

# Hanya untuk upload source map saat build (opsional, di CI/produksi).
# Tanpa ini, build tetap sukses — error tetap terlapor, hanya stack kurang rapi.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
