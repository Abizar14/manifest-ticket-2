# ─────────── Database ───────────
# Untuk Postgres (rekomendasi production):
DATABASE_URL="postgresql://afvs:afvs_password@localhost:5432/afvs?schema=public"
# Untuk SQLite (dev / single-gate):
# DATABASE_URL="file:./dev.db"

# ─────────── JWT ───────────
JWT_SECRET="ganti-dengan-string-random-min-32-char"
JWT_EXPIRES_IN="12h"

# ─────────── App ───────────
PORT=3001
NODE_ENV="development"
# CORS origin frontend Next.js
CORS_ORIGIN="http://localhost:3000"

# ─────────── File Storage ───────────
# Folder lokal untuk face/KTP photo. Pastikan writable.
UPLOAD_DIR="./uploads"
# Max file size dalam bytes (default 1MB)
UPLOAD_MAX_SIZE=1048576

# ─────────── Bootstrap admin ───────────
# Dipakai sekali saat seed; bisa dihapus setelahnya
SEED_ADMIN_EMAIL="admin@afvs.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Admin"
