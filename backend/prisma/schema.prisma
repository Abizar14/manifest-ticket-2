// AFVS — Prisma schema
// Provider default SQLite untuk dev cepat. Ganti ke "postgresql" untuk prod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite tidak support native enum — pakai string + check di app layer.
// Role: "operator" | "supervisor" | "admin"
// FlightStatus: "SCHEDULED" | "OPEN" | "ACTIVE" | "CLOSED" | "CANCELLED"

model Operator {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  pinHash      String?  // PIN cepat untuk petugas AVSEC (login-pin)
  name         String
  role         String   @default("operator")
  station      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scanEvents   ScanEvent[]

  @@index([station])
}

model Flight {
  id             String       @id @default(cuid())
  flightNumber   String
  airlineCode    String
  origin         String
  destination    String
  std            DateTime
  status         String       @default("SCHEDULED")
  station        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  scanEvents     ScanEvent[]

  @@unique([station, flightNumber, std])
  @@index([station, std])
  @@index([status])
}

model ScanEvent {
  id               String   @id @default(cuid())
  eventId          String   @unique
  rawBarcode       String
  flightNumber     String?
  pnr              String?
  ticketNumber     String?
  seat             String?
  passengerName    String?
  resultStatus     String
  message          String?
  scannedAt        DateTime
  station          String

  facePhotoPath    String?
  ktpStatus        String?
  ktpName          String?
  ktpSimilarity    Float?
  ktpCapturedAt    DateTime?

  flightId         String?
  flight           Flight?  @relation(fields: [flightId], references: [id])

  operatorId       String
  operator         Operator @relation(fields: [operatorId], references: [id])

  createdAt        DateTime @default(now())

  @@index([station, scannedAt])
  @@index([flightId])
  @@index([resultStatus])
}
